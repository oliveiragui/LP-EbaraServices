---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { brl, plans, site, wa } from '../data/site';
---
<section class="section section--dark closing" id="contato" data-spy="contato" aria-labelledby="contato-titulo">
  <div class="closing__bg" aria-hidden="true">
    <div class="closing__glow"></div>
  </div>

  <div class="container">
    <div class="closing__grid">
      <div class="closing__copy rv">
        <p class="eyebrow">Próximo Passo</p>
        <h2 class="h-section closing__title" id="contato-titulo">
          Vamos dar à sua oferta o caminho mais curto até a <span class="mark rv">venda?</span>
        </h2>
        <p class="lead closing__desc">
          Conte-nos sobre o seu produto ou serviço, quem é o seu público e o objetivo da página.
          Retornamos rapidamente com um diagnóstico inicial e o plano ideal para você.
        </p>

        <div class="closing__actions">
          <a class="btn btn--amber" href={wa('Olá! Gostaria de solicitar um diagnóstico para minha Landing Page na EBARA Services.')} target="_blank" rel="noopener" data-track="cta_closing_whatsapp">
            <Icon name="whatsapp" size={20} /> Solicitar Orçamento no WhatsApp
          </a>
          <button class="btn btn--ghost" id="copy-btn" type="button" aria-label="Copiar link desta página">
            <span id="copy-text">Copiar link</span>
          </button>
        </div>

        <p class="closing__terms">
          <Icon name="shield" size={16} />
          <span>Início imediato após alinhamento · <strong>50% só após você aprovar a página</strong></span>
        </p>
      </div>

      <div class="proposal-meta rv" style="--i:1">
        <div class="meta-card">
          <h3 class="meta-title">Resumo da Proposta</h3>
          <dl class="meta-list">
            <div class="meta-row">
              <dt>Serviço</dt>
              <dd>Criação de Landing Page</dd>
            </div>
            <div class="meta-row">
              <dt>Prazo médio</dt>
              <dd>{site.prazo}</dd>
            </div>
            <div class="meta-row">
              <dt>Valores</dt>
              <dd>{brl(plans.basico.price)} (Básico) ou {brl(plans.personalizado.price)} (Personalizado)</dd>
            </div>
            <div class="meta-row">
              <dt>Pix à vista</dt>
              <dd>5% de desconto ({brl(plans.basico.price * 0.95)} / {brl(plans.personalizado.price * 0.95)})</dd>
            </div>
            <div class="meta-row">
              <dt>Condição de pagamento</dt>
              <dd>Pix em 2 etapas: 50% para iniciar + 50% só na aprovação final</dd>
            </div>
            <div class="meta-row">
              <dt>Propriedade</dt>
              <dd>100% no seu domínio e no nome da sua empresa</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>

    <!-- Rodapé -->
    <footer class="footer">
      <div class="footer__inner">
        <Logo inverted={true} />
        <p class="footer__copy">
          © {new Date().getFullYear()} EBARA Services. Todos os direitos reservados.
          Estratégia, copywriting, design de conversão e engenharia de performance.
        </p>
        <div class="footer__badge">
          <span>Desenvolvido com Astro · Ultrarrápido</span>
        </div>
      </div>
    </footer>
  </div>
</section>

<!-- Toast para feedback de cópia -->
<div class="toast" id="toast" role="status" aria-live="polite">
  <Icon name="check" size={18} /> Link copiado para a área de transferência!
</div>

<style>
  .closing {
    position: relative;
    padding-top: clamp(96px, 14vw, 160px);
    padding-bottom: 48px;
    overflow: hidden;
  }
  .closing__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .closing__glow {
    position: absolute;
    top: -20%;
    left: 50%;
    transform: translateX(-50%);
    width: 900px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(255, 176, 0, 0.16) 0%, rgba(255, 176, 0, 0) 70%);
    filter: blur(40px);
  }

  .closing__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(48px, 6vw, 84px);
    align-items: center;
    margin-bottom: clamp(64px, 10vw, 120px);
  }
  .closing__copy {
    display: grid;
    gap: 24px;
  }
  .closing__title {
    color: #ffffff;
  }
  .closing__desc {
    color: var(--c-dark-muted);
  }
  .closing__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 6px;
  }
  .closing__terms {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    color: var(--c-dark-muted);
  }
  .closing__terms :global(svg) {
    color: var(--c-amber);
    flex: none;
  }
  .closing__terms strong {
    color: #ffffff;
  }

  /* Proposal Meta Card */
  .proposal-meta {
    display: flex;
    justify-content: center;
  }
  .meta-card {
    width: 100%;
    max-width: 460px;
    padding: 32px 30px;
    border-radius: var(--r-lg);
    background: var(--c-dark-2);
    border: 1px solid var(--c-dark-line);
    box-shadow: 0 28px 60px -20px rgba(0, 0, 0, 0.7);
  }
  .meta-title {
    font-family: var(--f-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--c-dark-line);
  }
  .meta-list {
    display: grid;
    gap: 14px;
  }
  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    font-size: 0.875rem;
  }
  .meta-row dt {
    color: var(--c-dark-muted);
    flex: none;
  }
  .meta-row dd {
    text-align: right;
    font-weight: 600;
    color: #ffffff;
  }

  /* Footer */
  .footer {
    position: relative;
    z-index: 1;
    padding-top: 32px;
    border-top: 1px solid var(--c-dark-line);
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }
  .footer__copy {
    font-size: 0.8125rem;
    color: var(--c-dark-muted);
    max-width: 60ch;
  }
  .footer__badge span {
    display: inline-flex;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    font-size: 0.75rem;
    color: var(--c-dark-muted);
  }

  /* Toast */
  .toast {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%) translateY(100px);
    z-index: 200;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 24px;
    border-radius: 999px;
    background: var(--c-ink);
    color: #ffffff;
    font-size: 0.9375rem;
    font-weight: 600;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.15);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.5s var(--ease-spring),
      opacity 0.3s;
  }
  .toast.is-active {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
  }
  .toast :global(svg) {
    color: var(--c-amber);
  }

  @media (max-width: 900px) {
    .closing__grid {
      grid-template-columns: 1fr;
    }
    .footer__inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
