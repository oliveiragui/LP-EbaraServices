---
import Icon from './Icon.astro';
import { brl, plans, wa } from '../data/site';
---
<section class="hero" id="inicio" data-spy="inicio">
  <div class="hero__bg" aria-hidden="true">
    <span class="blob blob--1"></span>
    <span class="blob blob--2"></span>
    <span class="hero__grid"></span>
  </div>

  <div class="container hero__layout">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow">Estúdio especialista em landing pages</p>

      <h1 class="hero__title">
        <span class="hero__context">Criação de landing page de alta conversão</span>
        <span class="h-display hero__display">
          <span class="line"><span style="--d:0">Seu anúncio traz</span></span>
          <span class="line"><span style="--d:1">o clique. A gente</span></span>
          <span class="line"><span style="--d:2">traz o <span class="mark hero__mark">cliente.</span></span></span>
        </span>
      </h1>

      <p class="lead hero__lead">
        Landing pages construídas sobre <strong>pesquisa de conversão</strong>, copy estratégica, SEO, GEO e métricas configuradas —
        rápidas como esta página e desenhadas para levar cada visitante a um único próximo passo.
      </p>

      <div class="hero__actions">
        <a class="btn btn--amber" href="#planos" data-magnetic data-track="cta_hero_planos">
          Ver planos e preços <Icon name="arrow" />
        </a>
        <a class="btn btn--ghost" href={wa()} target="_blank" rel="noopener" data-track="cta_hero_whatsapp">
          <Icon name="whatsapp" /> Falar no WhatsApp
        </a>
      </div>

      <ul class="hero__trigger" aria-label="Condições">
        <li><Icon name="check" size={16} /> A partir de {brl(plans.basico.price)}</li>
        <li><Icon name="check" size={16} /> 50% só depois de aprovar a página</li>
        <li><Icon name="check" size={16} /> 5% off no Pix à vista</li>
      </ul>
    </div>

    <div class="stage" id="stage" data-play role="group" aria-label="Demonstração animada das etapas de uma landing page" data-nosnippet>
      <div class="stage__inner">
        <div class="browser" aria-hidden="true">
          <div class="browser__bar">
            <i></i><i></i><i></i>
            <span class="browser__url">
              <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.4"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
              clinicaaurora.com.br
            </span>
            <span class="browser__live">No ar</span>
          </div>

          <div class="screen">
            <div class="m-nav">
              <span class="m-logo"><i></i>aurora</span>
              <span class="m-links"><span>Tratamentos</span><span>Resultados</span><span>Dúvidas</span></span>
              <span class="m-navbtn">Agendar</span>
            </div>

            <div class="m-hero">
              <div class="m-col">
                <span class="t m-tag" style="--d:0"><span class="sk"></span><span class="tx">Odontologia estética · SP</span></span>
                <p class="t m-h" style="--d:1"><span class="sk"></span><span class="tx">Sorriso novo em <u>2 consultas</u>, com planejamento digital.</span></p>
                <p class="t m-p" style="--d:2"><span class="sk"></span><span class="tx">Lentes de contato dental com avaliação gratuita e parcelamento em até 12x.</span></p>
                <div class="m-actions">
                  <span class="t m-btn" style="--d:3"><span class="sk"></span><span class="tx">Agendar avaliação →</span></span>
                  <span class="t m-proof" style="--d:4"><span class="sk"></span><span class="tx">★★★★★ 4,8 · 1.300 pacientes</span></span>
                </div>
              </div>
              <div class="m-form">
                <span class="t m-form__t" style="--d:2"><span class="sk"></span><span class="tx">Avaliação gratuita</span></span>
                <span class="m-input"></span>
                <span class="m-input"></span>
                <span class="m-submit"><span class="tx">Quero agendar</span><span class="ripple"></span></span>
              </div>
            </div>

            <div class="m-strip">
              <span class="t" style="--d:3"><span class="sk"></span><span class="tx">✓ Avaliação sem custo</span></span>
              <span class="t" style="--d:4"><span class="sk"></span><span class="tx">✓ Resultado em 2 sessões</span></span>
              <span class="t" style="--d:5"><span class="sk"></span><span class="tx">✓ 12x sem juros</span></span>
            </div>

            <div class="heat">
              <span style="--x:22%;--y:42%;--s:1.2"></span>
              <span style="--x:76%;--y:58%;--s:1.5"></span>
              <span style="--x:30%;--y:74%;--s:.9"></span>
              <span style="--x:86%;--y:12%;--s:.7"></span>
            </div>

            <span class="cursor">
              <svg viewBox="0 0 24 24" width="22" height="22"><path d="M4 2l16 9-7 2-3 7Z" fill="#0A0A0A" stroke="#fff" stroke-width="1.5" stroke-linejoin="round" /></svg>
            </span>
          </div>
        </div>

        <div class="fc fc--lead" aria-hidden="true">
          <span class="fc__icon"><Icon name="whatsapp" size={18} /></span>
          <span><strong>Novo lead recebido</strong><small>Mariana quer agendar avaliação · agora</small></span>
        </div>
        <div class="fc fc--score" aria-hidden="true">
          <svg viewBox="0 0 44 44" width="46" height="46"><circle cx="22" cy="22" r="19" fill="none" stroke="#f1efe9" stroke-width="5" /><circle class="fc__ring" cx="22" cy="22" r="19" fill="none" stroke="#FFB000" stroke-width="5" stroke-linecap="round" pathLength="100" /></svg>
          <span><strong>98</strong><small>PageSpeed</small></span>
        </div>
        <div class="fc fc--geo" aria-hidden="true">
          <span class="fc__icon fc__icon--dark"><Icon name="spark" size={16} /></span>
          <span><strong>Citada por IA</strong><small>“…recomendo a Clínica Aurora”</small></span>
        </div>
      </div>

      <div class="stage__tabs" role="tablist" aria-label="Etapas da demonstração">
        <button type="button" role="tab" class="stage__tab" data-phase-btn="0" aria-selected="true"><b>01</b> Pesquisa<i></i></button>
        <button type="button" role="tab" class="stage__tab" data-phase-btn="1" aria-selected="false"><b>02</b> Copy<i></i></button>
        <button type="button" role="tab" class="stage__tab" data-phase-btn="2" aria-selected="false"><b>03</b> Design<i></i></button>
        <button type="button" role="tab" class="stage__tab" data-phase-btn="3" aria-selected="false"><b>04</b> No ar<i></i></button>
      </div>
      <p class="stage__note">Exemplo ilustrativo · cliente fictício</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(120px, 16vh, 168px) 0 clamp(72px, 10vw, 120px);
    overflow: hidden;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .blob {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 176, 0, 0.32), rgba(255, 176, 0, 0) 62%);
    will-change: transform;
  }
  .blob--1 {
    width: 900px;
    height: 900px;
    right: -260px;
    top: -280px;
    animation: drift1 18s var(--ease-io) infinite alternate;
  }
  .blob--2 {
    width: 620px;
    height: 620px;
    left: -280px;
    bottom: -320px;
    background: radial-gradient(circle, rgba(255, 149, 0, 0.18), rgba(255, 149, 0, 0) 62%);
    animation: drift2 22s var(--ease-io) infinite alternate;
  }
  @keyframes drift1 {
    to {
      transform: translate(-120px, 80px) scale(1.12);
    }
  }
  @keyframes drift2 {
    to {
      transform: translate(140px, -60px) scale(0.92);
    }
  }
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(10, 10, 10, 0.13) 1px, transparent 1px);
    background-size: 26px 26px;
    mask-image: radial-gradient(ellipse 70% 60% at 70% 40%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 70% 40%, #000 20%, transparent 75%);
  }

  .hero__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
    gap: clamp(40px, 5vw, 72px);
    align-items: center;
  }
  .hero__copy {
    display: grid;
    gap: 28px;
    justify-items: start;
  }
  .hero__eyebrow {
    animation: fade-up 0.8s var(--ease-out) both;
  }
  .hero__title {
    display: grid;
    gap: 18px;
  }
  .hero__context {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--c-amber-ink);
    letter-spacing: -0.005em;
    animation: fade-up 0.8s var(--ease-out) 0.05s both;
  }
  .hero__display {
    display: block;
  }
  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .line > span {
    display: inline-block;
    animation: rise 0.9s var(--ease-out) both;
    animation-delay: calc(var(--d) * 80ms);
  }
  .hero__mark::before {
    animation: mark-in 0.9s var(--ease-out) 0.55s both;
  }
  @keyframes mark-in {
    from {
      transform: scaleX(0);
    }
  }
  .hero__lead {
    max-width: 560px;
    animation: fade-up 0.9s var(--ease-out) 0.2s both;
  }
  .hero__lead strong {
    color: var(--c-ink);
    font-weight: 650;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    animation: fade-up 0.9s var(--ease-out) 0.3s both;
  }
  .hero__trigger {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: 0.875rem;
    font-weight: 550;
    color: var(--c-ink-soft);
    animation: fade-up 0.9s var(--ease-out) 0.4s both;
  }
  .hero__trigger li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .hero__trigger :global(svg) {
    color: var(--c-ink);
    padding: 2px;
    border-radius: 50%;
    background: var(--c-amber);
  }

  /* ---------- Palco / mockup ---------- */
  .stage {
    position: relative;
    animation: stage-in 1.2s var(--ease-out) 0.15s both;
    perspective: 1600px;
  }
  @keyframes stage-in {
    from {
      opacity: 0;
      transform: translateY(40px) rotateX(8deg);
    }
  }
  .stage__inner {
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.6s var(--ease-out);
  }
  .browser {
    position: relative;
    border-radius: 16px;
    background: #fff;
    box-shadow: var(--shadow-lg), 0 60px 120px -60px rgba(255, 149, 0, 0.45);
    overflow: hidden;
  }
  .browser__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 11px 14px;
    border-bottom: 1px solid var(--c-line);
    background: #fbfaf7;
  }
  .browser__bar > i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #e4e1d9;
  }
  .browser__url {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: 12px;
    padding: 4px 12px;
    border-radius: 999px;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--c-line);
    font-size: 11px;
    color: var(--c-muted);
  }
  .browser__live {
    margin-left: auto;
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: var(--c-amber);
    color: var(--c-ink);
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 0.3s,
      transform 0.5s var(--ease-spring);
  }
  .stage.is-live .browser__live {
    opacity: 1;
    transform: none;
  }

  .screen {
    position: relative;
    font-size: 11px;
    line-height: 1.35;
    color: var(--c-ink);
    min-height: 360px;
  }
  .m-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 20px;
  }
  .m-logo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: -0.03em;
  }
  .m-logo i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #d9d6ce;
    transition: background 0.6s;
  }
  .m-links {
    display: flex;
    gap: 14px;
    color: var(--c-muted);
    font-size: 10px;
  }
  .m-navbtn {
    padding: 5px 10px;
    border-radius: 999px;
    background: #e6e4de;
    font-size: 10px;
    font-weight: 700;
    transition:
      background 0.6s,
      color 0.6s;
  }
  .m-hero {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 18px;
    align-items: center;
    margin: 0 12px;
    padding: 26px 18px 26px 20px;
    border-radius: 14px;
    background: #fff;
    transition:
      background 0.8s var(--ease-out),
      color 0.8s;
  }
  .m-col {
    display: grid;
    gap: 10px;
    justify-items: start;
  }
  .m-tag {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
  .m-h {
    font-family: var(--f-display);
    font-size: clamp(17px, 1.9vw, 23px);
    font-weight: 750;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }
  .m-h u {
    text-decoration: none;
    background: linear-gradient(var(--c-amber), var(--c-amber)) left 88% / 0 32% no-repeat;
    transition: background-size 0.8s var(--ease-out) 0.3s;
  }
  .m-p {
    color: var(--c-ink-soft);
    max-width: 30ch;
    transition: color 0.8s;
  }
  .m-actions {
    display: grid;
    gap: 9px;
    justify-items: start;
    margin-top: 4px;
  }
  .m-btn {
    padding: 7px 12px;
    border-radius: 999px;
    background: #e6e4de;
    font-weight: 700;
    font-size: 10px;
    transition:
      background 0.6s,
      color 0.6s;
  }
  .m-proof {
    font-size: 9px;
    color: var(--c-muted);
  }
  .m-form {
    display: grid;
    gap: 8px;
    padding: 14px;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 0 0 1px var(--c-line);
    transition: box-shadow 0.8s;
  }
  .m-form__t {
    font-weight: 700;
    font-size: 11px;
  }
  .m-input {
    height: 24px;
    border-radius: 6px;
    background: #f3f1ec;
  }
  .m-submit {
    position: relative;
    display: grid;
    place-items: center;
    height: 28px;
    border-radius: 7px;
    background: #e6e4de;
    font-weight: 700;
    font-size: 10px;
    overflow: hidden;
    transition:
      background 0.6s,
      color 0.6s;
  }
  .m-submit .tx {
    opacity: 0;
    transition: opacity 0.4s 0.2s;
  }
  .ripple {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 12px;
    margin: -6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.7);
    opacity: 0;
  }
  .m-strip {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin: 12px;
    padding: 11px 16px;
    border-radius: 10px;
    background: #f6f4ef;
    font-size: 9.5px;
    font-weight: 600;
    transition:
      background 0.8s,
      color 0.8s;
  }

  /* Texto: esqueleto (pesquisa/wireframe) → copy */
  .t {
    position: relative;
  }
  .t .sk {
    position: absolute;
    inset: 0.1em 0;
    border-radius: 4px;
    background: repeating-linear-gradient(to bottom, #e6e4de 0 0.78em, transparent 0.78em 1.05em);
    transform-origin: left center;
    transition:
      transform 0.6s var(--ease-out),
      opacity 0.4s;
    transition-delay: calc(var(--d, 0) * 70ms);
  }
  .m-btn .sk,
  .m-tag .sk,
  .m-proof .sk,
  .m-strip .sk,
  .m-form__t .sk {
    background: #e6e4de;
  }
  .m-btn .sk {
    inset: 0;
    border-radius: 999px;
  }
  .t .tx {
    opacity: 0;
    transition: opacity 0.5s var(--ease-out);
    transition-delay: calc(var(--d, 0) * 70ms + 120ms);
  }
  .stage.is-copy .t .sk {
    transform: scaleX(0);
    opacity: 0;
  }
  .stage.is-copy .t .tx,
  .stage.is-copy .m-submit .tx {
    opacity: 1;
  }

  /* Design */
  .stage.is-design .m-hero {
    background:
      radial-gradient(120% 140% at 100% 0%, rgba(255, 176, 0, 0.28), transparent 50%),
      #0a0a0a;
    color: #fff;
  }
  .stage.is-design .m-p {
    color: #c9c6bf;
  }
  .stage.is-design .m-tag,
  .stage.is-design .m-proof {
    color: #f3c35b;
  }
  .stage.is-design .m-h u {
    background-size: 100% 32%;
    color: #fff;
  }
  .stage.is-design .m-btn,
  .stage.is-design .m-navbtn,
  .stage.is-design .m-submit {
    background: var(--c-amber);
    color: var(--c-ink);
  }
  .stage.is-design .m-logo i {
    background: var(--c-amber);
  }
  .stage.is-design .m-form {
    box-shadow: 0 20px 30px -18px rgba(0, 0, 0, 0.6);
  }
  .stage.is-design .m-strip {
    background: var(--c-amber-soft);
  }

  /* Pesquisa: mapa de calor */
  .heat {
    position: absolute;
    inset: 40px 0 0;
    pointer-events: none;
    transition: opacity 0.6s;
  }
  .heat span {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: calc(90px * var(--s));
    height: calc(90px * var(--s));
    margin: calc(-45px * var(--s));
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 90, 0, 0.55), rgba(255, 176, 0, 0.35) 35%, transparent 68%);
    animation: heat 2.4s var(--ease-io) infinite alternate;
  }
  .heat span:nth-child(2) {
    animation-delay: -0.8s;
  }
  .heat span:nth-child(3) {
    animation-delay: -1.4s;
  }
  @keyframes heat {
    to {
      transform: scale(1.25);
      opacity: 0.7;
    }
  }
  .stage.is-copy .heat {
    opacity: 0;
  }

  /* Cursor clicando o CTA */
  .cursor {
    position: absolute;
    left: 88%;
    top: 92%;
    opacity: 0;
    filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.25));
  }
  .stage.is-live .cursor {
    animation: cursor-move 2.6s var(--ease-io) 0.2s both;
  }
  @keyframes cursor-move {
    0% {
      opacity: 0;
      left: 88%;
      top: 96%;
    }
    15% {
      opacity: 1;
    }
    60% {
      left: 78%;
      top: 63%;
      transform: scale(1);
    }
    68% {
      transform: scale(0.8);
    }
    76% {
      transform: scale(1);
    }
    100% {
      left: 78%;
      top: 63%;
      opacity: 1;
    }
  }
  .stage.is-live .ripple {
    animation: ripple 0.7s var(--ease-out) 1.9s both;
  }
  @keyframes ripple {
    from {
      opacity: 1;
      transform: scale(0);
    }
    to {
      opacity: 0;
      transform: scale(14);
    }
  }

  /* Cards flutuantes */
  .fc {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px 10px 10px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: var(--shadow);
    font-size: 12px;
    line-height: 1.3;
    opacity: 0;
    transform: translateY(16px) scale(0.9);
    transition:
      opacity 0.4s,
      transform 0.7s var(--ease-spring);
  }
  .fc strong {
    display: block;
    font-weight: 700;
  }
  .fc small {
    display: block;
    color: var(--c-muted);
    font-size: 11px;
  }
  .fc__icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--c-amber);
    color: var(--c-ink);
  }
  .fc__icon--dark {
    background: var(--c-ink);
    color: var(--c-amber);
  }
  .fc--lead {
    left: -28px;
    bottom: 54px;
  }
  .fc--score {
    right: -22px;
    top: 64px;
  }
  .fc--score strong {
    font-family: var(--f-display);
    font-size: 20px;
    line-height: 1;
  }
  .fc__ring {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transform: rotate(-90deg);
    transform-origin: center;
    transition: stroke-dashoffset 1.2s var(--ease-out) 0.5s;
  }
  .fc--geo {
    right: 26px;
    bottom: -22px;
  }
  .stage.is-live .fc {
    opacity: 1;
    transform: none;
  }
  .stage.is-live .fc--lead {
    transition-delay: 2.2s;
  }
  .stage.is-live .fc--score {
    transition-delay: 0.3s;
  }
  .stage.is-live .fc--geo {
    transition-delay: 1s;
  }
  .stage.is-live .fc__ring {
    stroke-dashoffset: 2;
