---
interface Props {
  name: 'arrow' | 'check' | 'whatsapp' | 'plus' | 'x' | 'clock' | 'card' | 'shield' | 'spark' | 'bolt' | 'chart' | 'search' | 'target' | 'pen';
  size?: number;
  class?: string;
}
const { name, size = 20, class: cls } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'check' && <path d="M20 6 9 17l-5-5" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'x' && <path d="M18 6 6 18M6 6l12 12" />}
  {name === 'clock' && <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>}
  {name === 'card' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 10h18M7 15h4" /></>}
  {name === 'shield' && <><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6Z" /><path d="m9 12 2 2 4-4" /></>}
  {name === 'spark' && <path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6" />}
  {name === 'bolt' && <path d="M13 2 4 14h7l-1 8 9-12h-7Z" />}
  {name === 'chart' && <><path d="M3 3v18h18" /><path d="m7 15 4-4 3 3 6-6" /></>}
  {name === 'search' && <><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></>}
  {name === 'target' && <><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><circle cx="12" cy="12" r="1" /></>}
  {name === 'pen' && <><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></>}
  {name === 'whatsapp' && <path d="M3.5 20.5 5 16a8.5 8.5 0 1 1 3.2 3.1Zm5-12c-.4 0-1 .4-1 1.4s.7 2.5 2 3.8 3 2.1 3.9 2.1 1.4-.7 1.4-1.1-.1-.4-.4-.6l-1.4-.7c-.3-.1-.5 0-.7.3l-.5.6c-.2.2-.4.2-.6.1a5.6 5.6 0 0 1-2.6-2.5c-.1-.2 0-.4.1-.5l.4-.5c.1-.2.2-.4.1-.6l-.6-1.5c-.1-.3-.3-.3-.5-.3Z" />}
</svg>
