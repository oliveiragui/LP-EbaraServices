---
interface Props {
  inverted?: boolean;
}
const { inverted = false } = Astro.props;
---
<span class:list={['logo', { 'logo--inv': inverted }]}>
  <svg class="logo__mark" viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
    <rect width="32" height="32" rx="8" fill="#FFB000" />
    <rect class="b b1" x="8" y="8" width="16" height="4" rx="2" fill="#0A0A0A" />
    <rect class="b b2" x="8" y="14" width="11" height="4" rx="2" fill="#0A0A0A" />
    <rect class="b b3" x="8" y="20" width="16" height="4" rx="2" fill="#0A0A0A" />
  </svg>
  <span class="logo__word"><b>EBARA</b> Services</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--f-display);
    font-size: 1.125rem;
    letter-spacing: -0.03em;
    color: var(--c-ink);
  }
  .logo--inv {
    color: #fff;
  }
  .logo__word {
    font-weight: 450;
  }
  .logo__word b {
    font-weight: 800;
  }
  /* As barras do "E" são um wireframe de landing page: animam no hover */
  .b {
    transform-box: fill-box;
    transform-origin: left center;
    transition: transform 0.5s var(--ease-spring);
  }
  :global(a:hover) > .logo .b1,
  .logo:hover .b1 {
    transform: scaleX(0.7);
  }
  :global(a:hover) > .logo .b2,
  .logo:hover .b2 {
    transform: scaleX(1.45);
    transition-delay: 0.05s;
  }
  :global(a:hover) > .logo .b3,
  .logo:hover .b3 {
    transform: scaleX(0.85);
    transition-delay: 0.1s;
  }
</style>
