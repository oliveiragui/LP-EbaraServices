---
import Icon from './Icon.astro';
import { site } from '../data/site';

const steps = [
  {
    num: '01',
    time: 'Dias 1 e 2',
    title: 'Diagnóstico & Pesquisa de Conversão',
    desc: 'Análise aprofundada da sua oferta, público-alvo, principais concorrentes e objeções reais de compra. Mapeamos os pontos de atrito antes de qualquer linha de design.',
    deliverable: 'Briefing estratégico validado e mapa mental da narrativa',
  },
  {
    num: '02',
    time: 'Dias 3 a 5',
    title: 'Estrutura & Copywriting de Conversão',
    desc: 'Redação persuasiva de todos os textos, títulos que prendem a atenção e CTAs estratégicos. A copy é aprovada antes do visual para que o design nasça a serviço do argumento.',
    deliverable: 'Documento completo de copy para sua leitura e aprovação',
  },
  {
    num: '03',
    time: 'Dias 6 a 9',
    title: 'Design Exclusivo & Motion Experience',
    desc: 'Criação visual sob medida para desktop e mobile, aplicando as cores da sua marca com contraste rigoroso e animações fluidas para encantar o cliente.',
    deliverable: 'Protótipo navegável para teste visual interativo',
  },
  {
    num: '04',
    time: 'Dias 10 a 13',
    title: 'Desenvolvimento em Astro, SEO & GEO',
    desc: 'Construção em código ultraleve com Astro. Implementação de Core Web Vitals no verde, dados estruturados (Schema.org), otimização para IAs (llms.txt) e rastreamento de métricas.',
    deliverable: 'Link exclusivo de homologação para testes reais',
  },
  {
    num: '05',
    time: 'Dias 13 a 15',
    title: 'Aprovação Final & Publicação',
    desc: 'Você avalia a página pronta. Aplicamos a rodada de ajustes necessária. Somente após a sua aprovação final você paga os 50% restantes e publicamos no seu domínio.',
    deliverable: 'Página no ar, tag manager ativo e 100% dos acessos entregues',
  },
];
---
<section class="section process" id="processo" data-spy="processo" aria-labelledby="processo-titulo">
  <div class="container process-layout">
    <div class="process-aside">
      <p class="eyebrow rv">Metodologia Transparente</p>
      <h2 class="h-section rv" style="--i:1" id="processo-titulo">
        Cinco etapas com <span class="mark rv">aprovação</span> em cada uma.
      </h2>
      <p class="lead rv" style="--i:2">
        Sem surpresas ou caixas-pretas. Você acompanha cada entrega, dá feedback direto e só avançamos para a próxima fase com o seu "de acordo".
      </p>

      <div class="process-card rv" style="--i:3">
        <div class="process-time-box">
          <Icon name="clock" size={28} />
          <div>
            <strong>{site.prazo}</strong>
            <span>Do briefing inicial ao lançamento no seu domínio</span>
          </div>
        </div>
        <div class="process-guarantee">
          <Icon name="shield" size={20} />
          <span><strong>Risco zero:</strong> a segunda metade do pagamento (50%) só é realizada depois que você vê e aprova a página completa.</span>
        </div>
      </div>
    </div>

    <ol class="process-steps">
      {steps.map((st, i) => (
        <li class="process-item spot rv" style={`--i:${i * 0.12}`}>
          <div class="process-num">
            <span>{st.num}</span>
            <div class="process-line" aria-hidden="true"></div>
          </div>
          <div class="process-content">
            <span class="process-badge">{st.time}</span>
            <h3 class="h-card process-h">{st.title}</h3>
            <p class="process-p">{st.desc}</p>
            <div class="process-deliv">
              <Icon name="check" size={14} />
              <span><strong>Você recebe:</strong> {st.deliverable}</span>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
    gap: clamp(40px, 6vw, 84px);
    align-items: start;
  }
  .process-aside {
    position: sticky;
    top: 100px;
    display: grid;
    gap: 24px;
  }
  .process-card {
    display: grid;
    gap: 16px;
    padding: 24px;
    border-radius: var(--r);
    background: var(--c-paper);
    border: 1px solid var(--c-line);
    box-shadow: var(--shadow-sm);
  }
  .process-time-box {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--c-ink);
  }
  .process-time-box :global(svg) {
    color: var(--c-amber-hot);
    flex: none;
  }
  .process-time-box strong {
    display: block;
    font-family: var(--f-display);
    font-size: 1.35rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .process-time-box span {
    font-size: 0.85rem;
    color: var(--c-muted);
  }
  .process-guarantee {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding-top: 14px;
    border-top: 1px dashed var(--c-line);
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--c-ink-soft);
  }
  .process-guarantee :global(svg) {
    color: var(--c-amber-ink);
    margin-top: 2px;
    flex: none;
  }

  .process-steps {
    display: grid;
    gap: 20px;
  }
  .process-item {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 20px;
    padding: 24px 26px;
    border-radius: var(--r);
    background: #ffffff;
    border: 1px solid var(--c-line);
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out);
  }
  .process-item:hover {
    transform: translateX(6px);
    box-shadow: var(--shadow);
    border-color: var(--c-amber);
  }
  .process-num {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .process-num span {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--c-ink);
    color: #ffffff;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 1.125rem;
    transition:
      background 0.3s,
      color 0.3s;
  }
  .process-item:hover .process-num span {
    background: var(--c-amber);
    color: var(--c-ink);
  }
  .process-content {
    display: grid;
    gap: 8px;
  }
  .process-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--c-amber-ink);
  }
  .process-h {
    color: var(--c-ink);
    letter-spacing: -0.02em;
  }
  .process-p {
    color: var(--c-ink-soft);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .process-deliv {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    padding: 8px 12px;
    border-radius: 8px;
    background: var(--c-paper);
    font-size: 0.85rem;
    color: var(--c-ink);
  }
  .process-deliv :global(svg) {
    color: var(--c-amber-hot);
    flex: none;
  }

  @media (max-width: 900px) {
    .process-layout {
      grid-template-columns: 1fr;
    }
    .process-aside {
      position: static;
    }
  }
  @media (max-width: 560px) {
    .process-item {
      grid-template-columns: 1fr;
      padding: 18px 20px;
    }
    .process-num {
      flex-direction: row;
      gap: 12px;
    }
    .process-num span {
      width: 36px;
      height: 36px;
      font-size: 0.95rem;
    }
  }
</style>
